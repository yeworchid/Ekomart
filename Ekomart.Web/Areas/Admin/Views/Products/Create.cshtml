@model AdminProductFormViewModel
@{
    Layout = null;
    var adminController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var isEdit = Model.Product.Id > 0;
    var pageTitle = isEdit ? "Edit product" : "Add product";
    var pageSubtitle = isEdit ? "Update catalog item data" : "Create a catalog item";
    var submitText = isEdit ? "Save changes" : "Publish product";
    var formAction = isEdit
        ? Url.Action("Edit", "Products", new { area = "Admin", id = Model.Product.Id })
        : Url.Action("Create", "Products", new { area = "Admin" });
    var previewKey = Model.Product.Id == 0 ? 1 : Model.Product.Id;
    var previewImage = StoreViewHelpers.ProductImage(Model.Product.ImageUrl, previewKey);
    var stockBadgeClass = Model.Product.StockQuantity > 0 ? "bg-label-success" : "bg-label-danger";
    var stockBadgeText = Model.Product.StockQuantity > 0 ? "In stock" : "Out of stock";
}
<!doctype html>

<html
  lang="en"
  class=" layout-navbar-fixed layout-menu-fixed layout-compact "
  dir="ltr"
  data-skin="default"
  data-bs-theme="light"
  data-assets-path="/assets/vuexy/"
  data-template="vertical-menu-template">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Create Product | Ekomart Admin</title>

    <meta name="description" content="" />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/assets/vuexy/img/favicon/favicon.ico" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&ampdisplay=swap"
      rel="stylesheet" />

    <link rel="stylesheet" href="/assets/vuexy/vendor/fonts/iconify-icons.css" />

    <script src="/assets/vuexy/vendor/libs/@@algolia/autocomplete-js.js"></script>

    <!-- Core CSS -->
    <!-- build:css assets/vendor/css/theme.css  -->

    <link rel="stylesheet" href="/assets/vuexy/vendor/libs/node-waves/node-waves.css" />

    <link rel="stylesheet" href="/assets/vuexy/vendor/libs/pickr/pickr-themes.css" />

    <link rel="stylesheet" href="/assets/vuexy/vendor/css/core.css" />
    <link rel="stylesheet" href="/assets/vuexy/css/demo.css" />

    <!-- Vendors CSS -->

    <link rel="stylesheet" href="/assets/vuexy/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />

    <!-- endbuild -->

    <link rel="stylesheet" href="/assets/vuexy/vendor/libs/select2/select2.css" />

    <!-- Page CSS -->

    <!-- Helpers -->
    <script src="/assets/vuexy/vendor/js/helpers.js"></script>
    <!--! Template customizer & Theme config files MUST be included after core stylesheets and helpers.js in the <head> section -->

    <!--? Template customizer: To hide customizer set displayCustomizer value false in config.js.  -->
    <script src="/assets/vuexy/vendor/js/template-customizer.js"></script>

    <!--? Config:  Mandatory theme config file contain global vars & default theme options, Set your preferred theme option in this file.  -->

    <script src="/assets/vuexy/js/config.js"></script>
  </head>

  <body>
    <!-- Layout wrapper -->
    <div class="layout-wrapper layout-content-navbar  ">
      <div class="layout-container">
        <!-- Menu -->

        <aside id="layout-menu" class="layout-menu menu-vertical menu">
          <div class="app-brand demo ">
            <a href="/Admin" class="app-brand-link">
              <span class="app-brand-logo demo">
                <span class="text-primary">
                  <svg width="32" height="22" viewBox="0 0 32 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path
                      fill-rule="evenodd"
                      clip-rule="evenodd"
                      d="M0.00172773 0V6.85398C0.00172773 6.85398 -0.133178 9.01207 1.98092 10.8388L13.6912 21.9964L19.7809 21.9181L18.8042 9.88248L16.4951 7.17289L9.23799 0H0.00172773Z"
                      fill="currentColor" />
                    <path
                      opacity="0.06"
                      fill-rule="evenodd"
                      clip-rule="evenodd"
                      d="M7.69824 16.4364L12.5199 3.23696L16.5541 7.25596L7.69824 16.4364Z"
                      fill="#161616" />
                    <path
                      opacity="0.06"
                      fill-rule="evenodd"
                      clip-rule="evenodd"
                      d="M8.07751 15.9175L13.9419 4.63989L16.5849 7.28475L8.07751 15.9175Z"
                      fill="#161616" />
                    <path
                      fill-rule="evenodd"
                      clip-rule="evenodd"
                      d="M7.77295 16.3566L23.6563 0H32V6.88383C32 6.88383 31.8262 9.17836 30.6591 10.4057L19.7824 22H13.6938L7.77295 16.3566Z"
                      fill="currentColor" />
                  </svg>
                </span>
              </span>
              <span class="app-brand-text demo menu-text fw-bold ms-3">Ekomart</span>
            </a>

            <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto">
              <i class="icon-base ti menu-toggle-icon d-none d-xl-block"></i>
              <i class="icon-base ti tabler-x d-block d-xl-none"></i>
            </a>
          </div>

          <div class="menu-inner-shadow"></div>

          <ul class="menu-inner py-1">
            <li class="menu-header small">
              <span class="menu-header-text">Ekomart</span>
            </li>
            <li class="menu-item @(adminController == "Dashboard" ? "active" : "")">
              <a href="/Admin" class="menu-link">
                <i class="menu-icon icon-base ti tabler-smart-home"></i>
                <div>Dashboard</div>
              </a>
            </li>
            <li class="menu-item @(adminController == "Products" ? "active" : "")">
              <a href="/Admin/Products" class="menu-link">
                <i class="menu-icon icon-base ti tabler-shopping-cart"></i>
                <div>Products</div>
              </a>
            </li>
            <li class="menu-item @(adminController == "Categories" ? "active" : "")">
              <a href="/Admin/Categories" class="menu-link">
                <i class="menu-icon icon-base ti tabler-category"></i>
                <div>Categories</div>
              </a>
            </li>
            <li class="menu-item @(adminController == "Orders" ? "active" : "")">
              <a href="/Admin/Orders" class="menu-link">
                <i class="menu-icon icon-base ti tabler-package"></i>
                <div>Orders</div>
              </a>
            </li>
            <li class="menu-item @(adminController == "Subscriptions" ? "active" : "")">
              <a href="/Admin/Subscriptions" class="menu-link">
                <i class="menu-icon icon-base ti tabler-credit-card"></i>
                <div>Subscriptions</div>
              </a>
            </li>
            <li class="menu-item @(adminController == "AuditLogs" ? "active" : "")">
              <a href="/Admin/AuditLogs" class="menu-link">
                <i class="menu-icon icon-base ti tabler-history"></i>
                <div>Audit logs</div>
              </a>
            </li>
            @if (User.IsInRole("Admin"))
            {
              <li class="menu-header small">
                <span class="menu-header-text">Access</span>
              </li>
              <li class="menu-item @(adminController == "Users" ? "active" : "")">
                <a href="/Admin/Users" class="menu-link">
                  <i class="menu-icon icon-base ti tabler-users"></i>
                  <div>Users</div>
                </a>
              </li>
              <li class="menu-item @(adminController == "Roles" ? "active" : "")">
                <a href="/Admin/Roles" class="menu-link">
                  <i class="menu-icon icon-base ti tabler-lock-access"></i>
                  <div>Roles</div>
                </a>
              </li>
            }
            <li class="menu-header small">
              <span class="menu-header-text">Storefront</span>
            </li>
            <li class="menu-item">
              <a href="/" class="menu-link">
                <i class="menu-icon icon-base ti tabler-home"></i>
                <div>Open shop</div>
              </a>
            </li>
          </ul>
        </aside>

        <div class="menu-mobile-toggler d-xl-none rounded-1">
          <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large text-bg-secondary p-2 rounded-1">
            <i class="ti tabler-menu icon-base"></i>
            <i class="ti tabler-chevron-right icon-base"></i>
          </a>
        </div>
        <!-- / Menu -->

        <!-- Layout container -->
        <div class="layout-page">
          <!-- Navbar -->

          <nav
            class="layout-navbar container-xxl navbar-detached navbar navbar-expand-xl align-items-center bg-navbar-theme"
            id="layout-navbar">
            <div class="layout-menu-toggle navbar-nav align-items-xl-center me-3 me-xl-0   d-xl-none ">
              <a class="nav-item nav-link px-0 me-xl-6" href="javascript:void(0)">
                <i class="icon-base ti tabler-menu-2 icon-md"></i>
              </a>
            </div>

            <div class="navbar-nav-right d-flex align-items-center justify-content-between" id="navbar-collapse">
              <div class="navbar-nav align-items-center">
                <span class="navbar-text fw-medium">Ekomart admin</span>
              </div>

              <ul class="navbar-nav flex-row align-items-center ms-md-auto">
                <li class="nav-item dropdown">
                  <a
                    class="nav-link dropdown-toggle hide-arrow btn btn-icon btn-text-secondary rounded-pill"
                    id="nav-theme"
                    href="javascript:void(0);"
                    data-bs-toggle="dropdown">
                    <i class="icon-base ti tabler-sun icon-22px theme-icon-active text-heading"></i>
                    <span class="d-none ms-2" id="nav-theme-text">Toggle theme</span>
                  </a>
                  <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="nav-theme-text">
                    <li>
                      <button type="button" class="dropdown-item align-items-center active" data-bs-theme-value="light" aria-pressed="false">
                        <span><i class="icon-base ti tabler-sun icon-22px me-3" data-icon="sun"></i>Light</span>
                      </button>
                    </li>
                    <li>
                      <button type="button" class="dropdown-item align-items-center" data-bs-theme-value="dark" aria-pressed="true">
                        <span><i class="icon-base ti tabler-moon-stars icon-22px me-3" data-icon="moon-stars"></i>Dark</span>
                      </button>
                    </li>
                    <li>
                      <button type="button" class="dropdown-item align-items-center" data-bs-theme-value="system" aria-pressed="false">
                        <span><i class="icon-base ti tabler-device-desktop-analytics icon-22px me-3" data-icon="device-desktop-analytics"></i>System</span>
                      </button>
                    </li>
                  </ul>
                </li>

                <li class="nav-item navbar-dropdown dropdown-user dropdown">
                  <a class="nav-link dropdown-toggle hide-arrow p-0" href="javascript:void(0);" data-bs-toggle="dropdown">
                    <div class="avatar avatar-online">
                      <span class="avatar-initial rounded-circle bg-label-primary">
                        <i class="icon-base ti tabler-user"></i>
                      </span>
                    </div>
                  </a>
                  <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                      <div class="dropdown-item mt-0">
                        <div class="d-flex align-items-center">
                          <div class="flex-shrink-0 me-2">
                            <div class="avatar avatar-online">
                              <span class="avatar-initial rounded-circle bg-label-primary">
                                <i class="icon-base ti tabler-user"></i>
                              </span>
                            </div>
                          </div>
                          <div class="flex-grow-1">
                            <h6 class="mb-0">@(User.Identity?.Name ?? "Admin")</h6>
                            <small class="text-body-secondary">@(User.IsInRole("Admin") ? "Admin" : "Manager")</small>
                          </div>
                        </div>
                      </div>
                    </li>
                    <li><div class="dropdown-divider my-1 mx-n2"></div></li>
                    <li>
                      <a class="dropdown-item" href="/Profile">
                        <i class="icon-base ti tabler-user me-3 icon-md"></i><span class="align-middle">Profile</span>
                      </a>
                    </li>
                    <li>
                      <a class="dropdown-item" href="/">
                        <i class="icon-base ti tabler-home me-3 icon-md"></i><span class="align-middle">Open shop</span>
                      </a>
                    </li>
                    <li><div class="dropdown-divider my-1 mx-n2"></div></li>
                    <li>
                      <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-grid px-2 pt-2 pb-1">
                        <button type="submit" class="btn btn-sm btn-danger d-flex justify-content-center">
                          <small class="align-middle">Logout</small>
                          <i class="icon-base ti tabler-logout ms-2 icon-14px"></i>
                        </button>
                      </form>
                    </li>
                  </ul>
                </li>
              </ul>
            </div>
          </nav>

          <!-- / Navbar -->

          <!-- Content wrapper -->
          <div class="content-wrapper">
            <!-- Content -->
            <div class="container-xxl flex-grow-1 container-p-y">
              <div class="app-ecommerce">
                <form id="admin-product-form" method="post" action="@formAction">
                  @Html.AntiForgeryToken()
                  <input asp-for="Product.Id" type="hidden" />
                </form>
                <!-- Add Product -->
                <div
                  class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-6 row-gap-4">
                  <div class="d-flex flex-column justify-content-center">
                    <h4 class="mb-1">@pageTitle</h4>
                    <p class="mb-0">@pageSubtitle</p>
                  </div>
                  <div class="d-flex align-content-center flex-wrap gap-4">
                    <a href="/Admin/Products" class="btn btn-label-secondary">Cancel</a>
                    <button type="submit" form="admin-product-form" class="btn btn-primary">@submitText</button>
                  </div>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                  <div class="alert alert-danger mb-6" role="alert">
                    <div asp-validation-summary="All"></div>
                  </div>
                }

                <div class="row">
                  <!-- First column-->
                  <div class="col-12 col-lg-8">
                    <!-- Product Information -->
                    <div class="card mb-6">
                      <div class="card-header">
                        <h5 class="card-title mb-0">Product information</h5>
                      </div>
                      <div class="card-body">
                        <div class="mb-6 form-control-validation">
                          <label class="form-label" for="ecommerce-product-name">Name</label>
                          <input type="text" class="form-control" id="ecommerce-product-name" placeholder="Product title" name="Product.Name" value="@Model.Product.Name" form="admin-product-form" aria-label="Product title" />
                          <span class="text-danger" asp-validation-for="Product.Name"></span>
                        </div>
                        <div class="mb-6 form-control-validation">
                            <label class="form-label" for="ecommerce-product-sku">Slug</label>
                            <input type="text" class="form-control" id="ecommerce-product-sku" placeholder="granola-mix" name="Product.Slug" value="@Model.Product.Slug" form="admin-product-form" aria-label="Product slug" />
                            <span class="text-danger" asp-validation-for="Product.Slug"></span>
                        </div>
                        <!-- Description -->
                        <div class="form-control-validation">
                          <label class="mb-1" for="ecommerce-product-description">Description (Optional)</label>
                          <textarea id="ecommerce-product-description" class="form-control" rows="8" name="Product.Description" form="admin-product-form">@Model.Product.Description</textarea>
                          <span class="text-danger" asp-validation-for="Product.Description"></span>
                        </div>
                      </div>
                    </div>
                    <!-- /Product Information -->
                    <!-- Media -->
                    <div class="card mb-6">
                      <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 card-title">Product Image</h5>
                      </div>
                      <div class="card-body">
                        <div class="d-flex align-items-center gap-4 mb-4">
                          <div class="avatar avatar-xl rounded-2 bg-label-secondary">
                            <img src="@previewImage" alt="Product preview" class="rounded-2" />
                          </div>
                          <div>
                            <h6 class="mb-1">Image preview</h6>
                            <small class="text-body-secondary">The product image is stored as an asset URL.</small>
                          </div>
                        </div>
                        <div class="form-control-validation">
                          <label class="form-label" for="ecommerce-product-image-url">Image URL</label>
                          <input id="ecommerce-product-image-url" class="form-control" name="Product.ImageUrl" value="@Model.Product.ImageUrl" placeholder="/assets/ekomart/images/grocery/01.jpg" form="admin-product-form" />
                          <span class="text-danger" asp-validation-for="Product.ImageUrl"></span>
                        </div>
                      </div>
                    </div>
                    <!-- /Media -->
                    <!-- Inventory -->
                    <div class="card mb-6">
                      <div class="card-header">
                        <h5 class="card-title mb-0">Inventory</h5>
                      </div>
                      <div class="card-body">
                        <div class="row g-4 align-items-end">
                          <div class="col-12 col-md-8 form-control-validation">
                            <label class="form-label" for="ecommerce-product-stock">Stock quantity</label>
                            <input
                              type="number"
                              class="form-control"
                              id="ecommerce-product-stock"
                              placeholder="Quantity"
                              name="Product.StockQuantity"
                              value="@Model.Product.StockQuantity"
                              min="0"
                              form="admin-product-form"
                              aria-label="Quantity" />
                            <span class="text-danger" asp-validation-for="Product.StockQuantity"></span>
                          </div>
                          <div class="col-12 col-md-4">
                            <div class="border rounded p-3 h-100">
                              <small class="text-body-secondary d-block mb-1">Current status</small>
                              <span class="badge @stockBadgeClass">@stockBadgeText</span>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                    <!-- /Inventory -->
                  </div>
                  <!-- /Second column -->

                  <!-- Second column -->
                  <div class="col-12 col-lg-4">
                    <!-- Pricing Card -->
                    <div class="card mb-6">
                      <div class="card-header">
                        <h5 class="card-title mb-0">Pricing</h5>
                      </div>
                      <div class="card-body">
                        <!-- Base Price -->
                        <div class="form-control-validation">
                          <label class="form-label" for="ecommerce-product-price">Base Price</label>
                          <input type="number" class="form-control" id="ecommerce-product-price" placeholder="Price" name="Product.Price" value="@Model.Product.Price.ToString("0.##", CultureInfo.InvariantCulture)" min="0.01" step="0.01" form="admin-product-form" aria-label="Product price" />
                          <span class="text-danger" asp-validation-for="Product.Price"></span>
                        </div>
                      </div>
                    </div>
                    <!-- /Pricing Card -->
                    <!-- Organize Card -->
                    <div class="card mb-6">
                      <div class="card-header">
                        <h5 class="card-title mb-0">Organize</h5>
                      </div>
                      <div class="card-body">
                        <div class="mb-6 col ecommerce-select2-dropdown form-control-validation">
                          <label class="form-label mb-1" for="vendor">Category</label>
                          <select id="vendor" class="select2 form-select" data-placeholder="Select category" name="Product.CategoryId" form="admin-product-form">
                              @foreach (var category in Model.Categories)
                              {
                                if (Model.Product.CategoryId == category.Id)
                                {
                                  <option value="@category.Id" selected>@category.Name</option>
                                }
                                else
                                {
                                  <option value="@category.Id">@category.Name</option>
                                }
                              }
                            </select>
                          <span class="text-danger" asp-validation-for="Product.CategoryId"></span>
                        </div>
                        <div class="form-check form-switch mb-0">
                          <input class="form-check-input" type="checkbox" id="status-org" name="Product.IsActive" value="true" form="admin-product-form" @(Model.Product.IsActive ? "checked" : "") />
                          <input type="hidden" name="Product.IsActive" value="false" form="admin-product-form" />
                          <label class="form-check-label" for="status-org">Product is active</label>
                        </div>
                      </div>
                    </div>
                    <!-- /Organize Card -->
                  </div>
                  <!-- /Second column -->
                </div>
              </div>
            </div>
            <!-- / Content -->

            <!-- Footer -->
            <footer class="content-footer footer bg-footer-theme">
              <div class="container-xxl">
                <div class="footer-container d-flex align-items-center justify-content-between py-4 flex-md-row flex-column">
                  <div class="text-body">
                    &#169;
                    <script>document.write(new Date().getFullYear());</script>
                    Ekomart Admin
                  </div>
                  <div class="d-none d-lg-inline-block">
                    <a href="/" class="footer-link me-4">Storefront</a>
                    <a href="/Admin" class="footer-link">Dashboard</a>
                  </div>
                </div>
              </div>
            </footer>
            <!-- / Footer -->

            <div class="content-backdrop fade"></div>
          </div>
          <!-- Content wrapper -->
        </div>
        <!-- / Layout page -->
      </div>

      <!-- Overlay -->
      <div class="layout-overlay layout-menu-toggle"></div>

      <!-- Drag Target Area To SlideIn Menu On Small Screens -->
      <div class="drag-target"></div>
    </div>
    <!-- / Layout wrapper -->

    <!-- Core JS -->
    <!-- build:js assets/vendor/js/theme.js  -->

    <script src="/assets/vuexy/vendor/libs/jquery/jquery.js"></script>

    <script src="/assets/vuexy/vendor/libs/popper/popper.js"></script>
    <script src="/assets/vuexy/vendor/js/bootstrap.js"></script>
    <script src="/assets/vuexy/vendor/libs/node-waves/node-waves.js"></script>

    <script src="/assets/vuexy/vendor/libs/pickr/pickr.js"></script>

    <script src="/assets/vuexy/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>

    <script src="/assets/vuexy/vendor/libs/hammer/hammer.js"></script>

    <script src="/assets/vuexy/vendor/libs/i18n/i18n.js"></script>

    <script src="/assets/vuexy/vendor/js/menu.js"></script>

    <!-- endbuild -->

    <!-- Vendors JS -->
    <script src="/assets/vuexy/vendor/libs/select2/select2.js"></script>

    <!-- Main JS -->

    <script src="/assets/vuexy/js/main.js"></script>

    <!-- Page JS -->
    <script>
      $(function () {
        $('.select2').each(function () {
          const $select = $(this);
          $select.wrap('<div class="position-relative"></div>').select2({
            dropdownParent: $select.parent(),
            placeholder: $select.data('placeholder')
          });
        });
      });
    </script>
  </body>
</html>
