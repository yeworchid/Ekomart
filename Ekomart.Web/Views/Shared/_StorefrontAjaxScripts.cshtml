@using System.Globalization
@using System.Text.Json
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var localizationKeys = new[]
    {
        "English",
        "Russian",
        "About Us",
        "About",
        "My Account",
        "Account",
        "Login",
        "We deliver to your everyday from 7:00 to 22:00",
        "Need help? Call Us:",
        "Home",
        "Shop",
        "Catalog",
        "All Categories",
        "Search for products, categories or brands",
        "Add",
        "Add To Cart",
        "Shopping Cart",
        "View Cart",
        "Checkout",
        "Place Order",
        "Cart Totals",
        "Sub Total:",
        "Total:",
        "Delivery Options",
        "Payment Method",
        "Free shipping",
        "Flat rate",
        "Local pickup",
        "Direct bank transfer",
        "Cash on delivery",
        "I have read and agree to terms and conditions.",
        "No products found",
        "Try changing the filters.",
        "Price",
        "Any",
        "item(s)",
        "In Stock",
        "Out Stock",
        "New Item",
        "Top Trending Products",
        "Featured Grocery",
        "Weekly Best Selling Groceries",
        "Product added to cart.",
        "Cart updated.",
        "Product removed from cart.",
        "Invalid product quantity.",
        "Could not update catalog.",
        "Could not prepare cart request.",
        "Subscription updated.",
        "Order status updated.",
        "Login is required.",
        "Request failed.",
        "Fill required checkout fields.",
        "New order #{0}",
        "Order #{0} status updated.",
        "Customer",
        "Order #{0} has been placed. Total: {1}.",
        "Realtime notifications are temporarily unavailable.",
        "Select a delivery method.",
        "Select a payment method.",
        "Accept the terms and conditions.",
        "Cart is empty.",
        "Add products from the catalog to continue.",
        "Go Shopping",
        "Quantity must be greater than zero.",
        "Product was not found.",
        "Product is out of stock.",
        "Cart item was not found.",
        "Sold Out",
        "Invalid email or password.",
        "Enter email.",
        "Enter a valid email.",
        "Enter password.",
        "Enter name.",
        "Name cannot be longer than 120 characters.",
        "Password must be between 6 and 100 characters.",
        "Passwords must match.",
        "Profile saved.",
        "Select a subscription plan.",
        "Subscription {0} is active until {1}.",
        "Subscription plan was not found.",
        "Status",
        "Active until"
    };
    var translations = localizationKeys.ToDictionary(key => key, key => L[key].Value);
    translations["CheckOut"] = translations["Checkout"];
    var localizationPayload = new
    {
        currentCulture,
        translations
    };
    var authPayload = new
    {
        isAuthenticated
    };
}

<style>
    .product-details-popup-btn,
    .btn-border-only.cart .card-number-show,
    .coupon-input-area-1,
    .bottom-cupon-code-cart-area form,
    .discount-area .countdown,
    .footersubscribe-form,
    .our-payment-method,
    .nav-h_top.language .language-hover:nth-child(n+2),
    .nav-h_top li:has(> a[href*="about.html"]),
    .nav-h_top li:has(> a[href*="trackorder.html"]),
    .nav-area .parent-nav > li:nth-child(2),
    .nav-area .parent-nav > li:nth-child(n+4),
    .nav-area .parent-nav > li:nth-child(1) .submenu,
    .nav-area .parent-nav > li:nth-child(3) .rts-megamenu,
    .mobile-menu-main nav > ul > li:nth-child(2),
    .mobile-menu-main nav > ul > li:nth-child(3),
    .mobile-menu-main nav > ul > li:nth-child(5),
    .mobile-menu-main nav > ul > li:nth-child(1) .submenu,
    .mobile-menu-main nav > ul > li:nth-child(4) .submenu,
    .category-sub-menu .submenu,
    .right-btn-area,
    .price-input-area input.range,
    .social-one-wrapper,
    .playstore-app-area,
    .single-footer-wized:has(.footer-nav),
    .single-footer-wized:has(.footersubscribe-form),
    .product-discription-tab-shop #profile-tabt,
    .product-discription-tab-shop #profile-tab-panes,
    .product-discription-tab-shop #profile-tab,
    .product-discription-tab-shop #profile-tab-pane {
        display: none !important;
    }

    .product-details-popup-wrapper.in-shopdetails .details-product-area {
        width: 100%;
    }

    .mobile-menu-main nav > ul > li:nth-child(1)::after,
    .mobile-menu-main nav > ul > li:nth-child(4)::after {
        display: none !important;
    }

    .title-area-between .countdown {
        display: none !important;
    }

    .nav-h_top.language {
        display: inline-flex !important;
        align-items: center;
        width: auto !important;
    }

    .nav-h_top.language .language-hover {
        display: inline-flex !important;
        align-items: center;
        width: auto !important;
        min-width: 0 !important;
        padding: 0 !important;
        position: relative;
    }

    .nav-h_top.language .language-hover > a {
        display: inline-flex !important;
        align-items: center;
        width: auto !important;
        white-space: nowrap;
    }

    .nav-h_top.language .language-hover .category-sub-menu {
        left: auto !important;
        right: 0 !important;
        top: calc(100% + 8px) !important;
        width: 150px !important;
        display: none !important;
        opacity: 0 !important;
        visibility: hidden !important;
        pointer-events: none !important;
        transform: translateY(8px) !important;
        transition: opacity .18s ease, transform .18s ease, visibility .18s ease !important;
    }

    .nav-h_top.language .language-hover:hover .category-sub-menu {
        display: none !important;
        opacity: 0 !important;
        visibility: hidden !important;
        pointer-events: none !important;
        transform: translateY(8px) !important;
    }

    .nav-h_top.language .language-hover.is-open .category-sub-menu {
        display: flex !important;
        opacity: 1 !important;
        visibility: visible !important;
        pointer-events: auto !important;
        transform: translateY(0) !important;
    }

    .nav-h_top.language .language-hover::after,
    .nav-h_top.language .language-hover:hover::after {
        pointer-events: none !important;
    }

    .product-details-popup-wrapper.in-shopdetails .product-thumb-area {
        flex: 0 0 auto;
        max-width: 450px;
    }

    .product-details-popup-wrapper.in-shopdetails .product-details-popup .product-thumb {
        width: min(450px, 100%) !important;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        background-size: cover;
        background-position: center;
    }

    .product-details-popup-wrapper.in-shopdetails .product-details-popup .product-thumb img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .action-share-option:has(.product-details-popup-btn),
    .ekomart-product-card .action-share-option {
        display: none !important;
    }

    .ekomart-product-card .thumbnail-preview {
        position: relative;
    }

    .ekomart-product-card .thumbnail-preview .ekomart-stock-badge {
        top: 8px !important;
        left: 14px !important;
        z-index: 6 !important;
        width: 50px;
        height: 50px;
        padding: 0 !important;
    }

    .ekomart-product-card .thumbnail-preview .ekomart-stock-badge i {
        font-size: 50px;
    }

    .ekomart-product-card .thumbnail-preview .ekomart-stock-badge span {
        top: 14px !important;
        left: 13px !important;
        width: 28px;
        text-align: center !important;
        font-size: 10px !important;
        line-height: 1.05 !important;
    }

    .ekomart-product-card.is-sold-out .thumbnail-preview img {
        opacity: .48;
        filter: grayscale(1);
    }

    .ekomart-product-card.is-sold-out .thumbnail-preview .ekomart-stock-badge i {
        color: #9CA3AF;
    }

    .ekomart-product-card.is-sold-out .rts-btn[disabled],
    .ekomart-product-card.is-sold-out .rts-btn.disabled,
    .ekomart-product-card.is-sold-out .quantity-edit.disabled {
        opacity: .72;
        cursor: not-allowed;
    }

    .product-details-popup-wrapper.in-shopdetails .contents,
    .product-discription-tab-shop .details-row-2 .right {
        min-width: 0;
        flex: 1 1 auto;
    }

    .single-shopping-card-one:not(.discount-offer):not(.tranding-product):not(.deals-of-day):has(.image-and-action-area-wrapper) {
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .single-shopping-card-one:not(.discount-offer):not(.tranding-product):not(.deals-of-day) .image-and-action-area-wrapper .thumbnail-preview {
        height: 180px !important;
        display: flex !important;
        align-items: center;
        justify-content: center;
        background: #fff;
    }

    .single-shopping-card-one:not(.discount-offer):not(.tranding-product):not(.deals-of-day) .image-and-action-area-wrapper .thumbnail-preview img {
        width: 100% !important;
        height: 100% !important;
        object-fit: contain;
    }

    .single-shopping-card-one:not(.discount-offer):not(.tranding-product):not(.deals-of-day) .body-content {
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
    }

    .single-shopping-card-one:not(.discount-offer):not(.tranding-product):not(.deals-of-day) .cart-counter-action {
        margin-top: auto;
        padding-top: 10px;
    }

    .single-shopping-card-one .cart-counter-action .quantity-edit.visually-hidden {
        display: none !important;
    }

    .swiper-slide .ekomart-product-card {
        width: 100%;
        min-width: 0;
    }

    .quantity-edit input.input {
        width: 30px !important;
        min-width: 30px !important;
        max-width: 30px !important;
        padding: 0 !important;
        border: 0 !important;
        background: transparent !important;
        color: #1F1F25 !important;
        font-size: 14px !important;
        line-height: 1.2 !important;
        font-weight: 600 !important;
        text-align: center !important;
        appearance: textfield;
        -webkit-appearance: none;
        -moz-appearance: textfield;
    }

    .quantity-edit input.input::-webkit-outer-spin-button,
    .quantity-edit input.input::-webkit-inner-spin-button {
        margin: 0;
        -webkit-appearance: none;
    }

    .quantity-edit.quantity-control {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        width: auto !important;
        min-width: 112px !important;
        box-sizing: border-box !important;
        padding: 4px 6px !important;
        border: 1px solid #E2E2E2 !important;
        border-radius: 6px !important;
        background: #fff !important;
    }

    .quantity-edit.quantity-control .button-wrapper-action {
        display: contents !important;
    }

    .quantity-edit.quantity-control .button {
        width: 24px !important;
        min-width: 24px !important;
        max-width: 24px !important;
        height: 24px !important;
        flex: 0 0 24px !important;
        padding: 0 !important;
        border: 0 !important;
        border-radius: 4px !important;
        box-sizing: border-box !important;
        background: #F3F5F0 !important;
        color: #2C3C28 !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        font-size: 14px !important;
        font-weight: 600 !important;
        line-height: 1 !important;
        cursor: pointer;
    }

    .quantity-edit.quantity-control .button:hover {
        background: #629D23 !important;
        color: #fff !important;
    }

    .quantity-edit.quantity-control.disabled .button,
    .quantity-edit.quantity-control .button:disabled {
        cursor: not-allowed !important;
        opacity: .55;
    }

    .checkout-field-error {
        margin-top: 8px;
        font-size: 14px;
    }

    .right-card-sidebar-checkout .cottom-cart-right-area li,
    .right-card-sidebar-checkout .cottom-cart-right-area label,
    .right-card-sidebar-checkout .single-category,
    .right-card-sidebar-checkout .single-category label {
        cursor: pointer;
    }

    .is-invalid-choice > span,
    .is-invalid-choice label,
    .is-invalid-choice h6 {
        color: #dc3545 !important;
    }

    .product-discription-tab-shop .details-row-2 .left-area {
        flex: 0 0 240px;
        min-width: 0 !important;
        max-width: 240px;
    }

    .product-discription-tab-shop .details-row-2 .left-area img {
        width: 100%;
        max-width: 100%;
        min-width: 0 !important;
        height: auto;
        object-fit: contain;
    }

    @@media (max-width: 1199px) {
        .product-details-popup-wrapper.in-shopdetails .product-thumb-area,
        .product-details-popup-wrapper.in-shopdetails .product-details-popup .product-thumb,
        .product-discription-tab-shop .details-row-2 .left-area {
            max-width: 100%;
        }

        .product-discription-tab-shop .details-row-2 .left-area {
            flex-basis: auto;
        }
    }

    @@media (max-width: 575px) {
        .single-shopping-card-one:not(.discount-offer):not(.tranding-product):not(.deals-of-day) .image-and-action-area-wrapper .thumbnail-preview {
            height: 170px !important;
        }
    }

    @if (!isAuthenticated)
    {
        <text>
    .accont-wishlist-cart-area-header .btn-border-only.cart {
        display: none !important;
    }
        </text>
    }
</style>

@if (isAuthenticated)
{
    <div data-order-realtime hidden></div>
    <script defer src="/lib/signalr/signalr.min.js"></script>
}
<script type="application/json" id="storefront-localization">@Html.Raw(JsonSerializer.Serialize(localizationPayload))</script>
<script type="application/json" id="storefront-auth">@Html.Raw(JsonSerializer.Serialize(authPayload))</script>
<script defer src="/js/ekomart-ajax.js?v=guest-cart-realtime-1"></script>
