@model Ekomart.Web.Models.Store.CatalogIndexViewModel
@using Ekomart.Web.Models.Store
@{
    var firstProductNumber = Model.Products.TotalCount == 0
        ? 0
        : ((Model.Products.PageNumber - 1) * Model.Products.PageSize) + 1;
    var lastProductNumber = Math.Min(Model.Products.PageNumber * Model.Products.PageSize, Model.Products.TotalCount);
    var returnUrl = $"{ViewContext.HttpContext.Request.Path}{ViewContext.HttpContext.Request.QueryString}";
}

<div class="filter-select-area">
    <div class="top-filter">
        <span>Showing @firstProductNumber-@lastProductNumber of @Model.Products.TotalCount results</span>
        <div class="right-end">
            <span>Sort: @(string.IsNullOrWhiteSpace(Model.Filter.Sort) ? "Latest" : Model.Filter.Sort)</span>
        </div>
    </div>
    <form asp-controller="Catalog" asp-action="Index" method="get" class="nice-select-area-wrapper-and-button" data-catalog-filter>
        <div class="nice-select-wrapper-1">
            <div class="single-select">
                <input type="text" name="Search" value="@Model.Filter.Search" placeholder="Search products">
            </div>
            <div class="single-select">
                <select name="CategorySlug">
                    <option value="">All Categories</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Slug" selected="@(category.Slug == Model.Filter.CategorySlug ? "selected" : null)">@category.Name</option>
                    }
                </select>
            </div>
            <div class="single-select">
                <select name="Sort">
                    <option value="">Latest</option>
                    <option value="price-asc" selected="@(Model.Filter.Sort == "price-asc" ? "selected" : null)">Price: Low to High</option>
                    <option value="price-desc" selected="@(Model.Filter.Sort == "price-desc" ? "selected" : null)">Price: High to Low</option>
                    <option value="name-desc" selected="@(Model.Filter.Sort == "name-desc" ? "selected" : null)">Name: Z to A</option>
                </select>
            </div>
            <div class="single-select">
                <input type="hidden" name="MinPrice" value="@Model.Filter.MinPrice">
                <input type="hidden" name="MaxPrice" value="@Model.Filter.MaxPrice">
                <input type="hidden" name="PageSize" value="@Model.Filter.PageSize">
            </div>
        </div>
        <div class="button-area">
            <button class="rts-btn" type="submit">Filter</button>
            <a asp-controller="Catalog" asp-action="Index" class="rts-btn" data-catalog-link>Reset Filter</a>
        </div>
    </form>
</div>

@if (TempData["CartMessage"] is string cartMessage)
{
    <div class="alert alert-success mt--20" data-ajax-message>@cartMessage</div>
}
@if (TempData["CartError"] is string cartError)
{
    <div class="alert alert-danger mt--20" data-ajax-message>@cartError</div>
}

<div class="product-area-wrapper-shopgrid-list mt--20">
    <div class="row g-4">
        @if (Model.Products.Items.Count == 0)
        {
            <div class="col-12">
                <div class="single-shopping-card-one p--30">
                    <h4 class="title">No products found</h4>
                    <p class="availability">Try changing the filters.</p>
                </div>
            </div>
        }
        else
        {
            foreach (var item in Model.Products.Items)
            {
                <div class="col-lg-20 col-lg-4 col-md-6 col-sm-6 col-12">
                    @await Html.PartialAsync("_ProductCard", new ProductCardViewModel
                    {
                        Product = item,
                        ReturnUrl = returnUrl
                    })
                </div>
            }
        }
    </div>
</div>

@if (Model.Products.TotalPages > 1)
{
    <div class="pagination-area-main-wrappper mt--40">
        <ul>
            @for (var pageNumber = 1; pageNumber <= Model.Products.TotalPages; pageNumber++)
            {
                <li>
                    <a class="@(pageNumber == Model.Products.PageNumber ? "active" : null)"
                       data-catalog-link
                       href="@Url.Action("Index", "Catalog", new { pageNumber, pageSize = Model.Filter.PageSize, search = Model.Filter.Search, categorySlug = Model.Filter.CategorySlug, minPrice = Model.Filter.MinPrice, maxPrice = Model.Filter.MaxPrice, sort = Model.Filter.Sort })">@pageNumber</a>
                </li>
            }
        </ul>
    </div>
}
